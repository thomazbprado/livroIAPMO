# IA PM: configuração por variáveis de ambiente. Copie para .env e ajuste.
# NUNCA coloque este arquivo (nem chaves reais) no repositório.

# dev ou prod. Em prod, IAPM_SECRET_KEY é obrigatória e os cookies passam a ser "Secure" (exigem HTTPS).
IAPM_ENV=dev

# Valor aleatório longo (ex.: python -c "import secrets; print(secrets.token_urlsafe(48))").
# Assina as sessões e deriva a chave que cifra as chaves BYOK. Trocar este valor derruba as sessões
# e invalida as chaves BYOK já salvas (os clientes precisam cadastrá-las de novo).
IAPM_SECRET_KEY=

# SQLite por padrão (arquivo em ./data). Para PostgreSQL:
# IAPM_DATABASE_URL=postgresql+psycopg://usuario:senha@host:5432/iapm
IAPM_DATABASE_URL=

# Chave da conta da plataforma na Anthropic: é ela que paga as execuções feitas com "créditos".
# Sem ela, os créditos gerenciados ficam indisponíveis e só funcionam BYOK e demonstração.
# Defina um limite de gasto nessa chave no console do provedor.
ANTHROPIC_API_KEY=

# Câmbio usado para converter o custo em USD para créditos (hipótese: ajuste ao câmbio real).
IAPM_USD_BRL=5.50

# demo: planos e créditos podem ser "contratados" sem pagamento (SÓ para demonstração).
# disabled: contratação online desligada (use em produção até integrar um gateway de pagamento).
IAPM_BILLING_MODE=demo

# Cadastro aberto. Em 0, só entra quem recebe convite de uma organização.
IAPM_ALLOW_SIGNUP=1

# Cria a conta da equipe da plataforma (gera códigos do livro, vê solicitações e usuários) na primeira subida.
IAPM_ADMIN_EMAIL=
IAPM_ADMIN_PASSWORD=

# Retenção das execuções (dias), aplicada por: python -m app.cli purge
IAPM_RETENCAO_DIAS=365

# Páginas /docs e /openapi.json da API (1 liga, 0 desliga).
IAPM_DOCS=1

# Tamanho máximo da resposta do modelo (tokens) e duração da sessão (horas).
IAPM_MAX_TOKENS=32000
IAPM_SESSAO_HORAS=12

# Fallback no servidor do provedor: se um classificador de segurança recusar a requisição, ela é refeita em outro modelo.
IAPM_ENABLE_FALLBACKS=1
